# ── 複製為 .env 後填入（.env 不會進版控）──

# 地端 Ollama 端點（預設本機）
OLLAMA_BASE_URL=http://localhost:11434

# 自架 H200 vLLM 推論伺服器（OpenAI 相容；需連 VPN，過渡期另需 SSH 橋接在跑）
# 防火牆開通後改為 http://192.168.10.105:22003/v1
H200_BASE_URL=http://127.0.0.1:18000/v1
H200_API_KEY=EMPTY

# 雲端 API 金鑰（不使用雲端可留空；留空時該雲端選項會自動隱藏）
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# 伺服器
HOST=127.0.0.1
PORT=8090
